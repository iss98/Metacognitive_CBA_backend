rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Netlify는 Firestore에 직접 접근하지 않고 Cloud Run API만 호출한다.
    // Cloud Run 서버 SDK는 이 규칙이 아니라 Google Cloud IAM으로 인증한다.
    // 연구 데이터가 브라우저에 직접 노출되지 않도록 모든 클라이언트
    // 읽기와 쓰기를 기본 거부한다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
